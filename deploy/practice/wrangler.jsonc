{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kaikoulian-api",
  "account_id": "10f5e44abaee0dae593e18c144327b17",
  "main": "worker.ts",
  "compatibility_date": "2026-05-22",
